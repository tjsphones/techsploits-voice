# Copy this file to .env and fill in the values.
# NEVER commit the real .env. These are the same secrets you already have in
# C:\Users\tl\AppData\Local\hermes\.env for SignalWire.

# --- SignalWire (from your Desktop creds file) ---
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_SPACE_URL=techsploits.signalwire.com
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_TOKEN=
SIGNALWIRE_PHONE=406-416-6665

# --- Nous (the brain). Get a free key at https://portal.nousresearch.com ---
NOUS_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=tencent/hy3:free

# --- Speech-to-text: Deepgram (handles telephony audio natively) ---
DEEPGRAM_API_KEY=

# --- Text-to-speech: elevenlabs | openai | azure ---
TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
# Optional: voice id for elevenlabs; leave blank for default

# --- Mid-call email (SWAIG) ---
SHOP_EMAIL=brent@techsploits.com
# For sending email we relay through your Gmail SMTP (app password), or a
# transactional provider. See README "Email" section.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_USER=tjsworldmt@gmail.com
EMAIL_SMTP_PASS=

# --- Misc ---
DRY_RUN=false
PORT=8080
